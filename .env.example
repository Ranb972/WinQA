# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx

# Admin allowlist (comma-separated Clerk user IDs) for destructive seed operations.
# Without this, PUT /api/seed returns 403 for all users (fail-closed).
# Format: comma-separated Clerk user IDs (Clerk dashboard > Users > copy the user_... id). Replace these placeholders.
ADMIN_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxxx,user_yyyyyyyyyyyyyyyyyyyyyyyyy

# Clerk webhook signing secret (whsec_...) for POST /api/webhooks/clerk, which purges a
# deleted user's data on user.deleted. Clerk dashboard > Webhooks > the endpoint for
# https://www.winqa.ai/api/webhooks/clerk > Signing Secret. Unset: the endpoint answers 500.
# CLERK_WEBHOOK_SIGNING_SECRET=

# MongoDB
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/winqa

# App URL (your production domain)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# LLM API Keys (optional - users can provide their own in Settings)
# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_key

# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_google_key

# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_key

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key

# Code Execution (optional)
# Judge0: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_judge0_key

# Per-user daily cap on server-side LLM requests (UTC day). Optional; lib/rate-limit.ts defaults to 300.
DAILY_LLM_LIMIT=300

# Vercel cron auth — Vercel automatically sends "Authorization: Bearer ${CRON_SECRET}"
# on cron HTTP requests when this env var is set in the project settings.
# Generate with: openssl rand -hex 32  (or any 32+ char random hex)
# Set in Vercel: Project Settings → Environment Variables → CRON_SECRET (Production)
CRON_SECRET=
